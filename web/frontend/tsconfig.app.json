{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Общие страницы и компоненты сайтов: web/shared_web/frontend (копия parlaments/shared_web, alias @shared-web), модули сайта — @app;
       npm-пакеты для файлов вне проекта — из node_modules этого проекта */
    "paths": {
      "@app/*": ["./src/*"],
      "@shared-web/*": ["../shared_web/frontend/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared_web/frontend"]
}
